    "min": 13,
    "max": 20,
    "step": 0.5,
    "default": 16,
    "unit": "mm",
    "help": "Carabiner hole diameter in the anchor plate, at its narrowest. It holds the carabiner right under the grip, so the edge should stay level. That is not measured yet.",
    "simple": true
   },
   {
    "name": "top_t",
    "label": "Top wall",
    "type": "number",
    "min": 8,
    "max": 12,
    "step": 0.5,
    "default": 10,
    "unit": "mm",
    "help": "The insert presses up on it. Thicker is stiffer and heavier.",
    "simple": false
   },
   {
    "name": "floor_t",
    "label": "Floor",
    "type": "number",
    "min": 8,
    "max": 12,
    "step": 0.5,
    "default": 8,
    "unit": "mm",
    "help": "Ties the anchor plate to the walls.",
    "simple": false
   },
   {
    "name": "corner",
    "label": "Corner radius",
    "type": "number",
    "min": 3,
    "max": 12,
    "step": 0.5,
    "default": 6,
    "unit": "mm",
    "help": "Rounding of the housing corners, seen from the front.",
    "simple": false
   }
  ],
  "cards": [
   {
    "title": "Hanging",
