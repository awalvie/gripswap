  ]
 },
 "inserts": [
  {
   "id": "edge",
   "name": "Edge",
   "blurb": "flat, ergo, incut or sloper",
   "simple_choice": {
    "label": "Shape",
    "options": [
     {
      "label": "Flat",
      "icon": "flat",
      "blurb": "classic edge",
      "values": {
       "edge_angle": 0,
       "ergo": 0,
       "grip_r": 3
      }
     },
     {
      "label": "Ergo",
      "icon": "ergo",
      "blurb": "curved for longer middle fingers",
      "values": {
       "edge_angle": 0,
       "ergo": 5,
       "grip_r": 4
      }
     },
     {
      "label": "Incut",
      "icon": "incut",
      "blurb": "tilts in 10°, better traction",
      "values": {
       "edge_angle": 10,
       "ergo": 0,
       "grip_r": 2.5
      }
     },
     {
      "label": "Sloper",
      "icon": "sloper",
      "blurb": "round 35° curve, open hand",
      "values": {
       "edge_angle": -35,
       "ergo": 0,
       "slot_d": 25
      }
     }
    ]
   },
   "parts": [
    {
     "part": "insert_edge",
     "name": "Edge insert",
     "supports": "no supports",
     "settings": "3 walls · 15% gyroid"
    },
    {
     "part": "fuzzy_edge",
     "name": "Fuzzy modifier",
     "supports": "PrusaSlicer: load it with the insert as one object",
     "when": {
      "texture": [
       "fuzzy"
      ]
     },
     "modifier": true
    },
    {
     "part": "fuzzy_edge_3mf",
     "name": "Bambu Orca",
     "threemf": [
      "insert_edge",
      "fuzzy_edge"
     ],
     "print": {
      "wall_loops": 3,
      "sparse_infill_density": "15%",
      "sparse_infill_pattern": "gyroid"
     },
     "settings": "insert and texture in one file",
     "supports": "Bambu Studio and Orca Slicer",
     "when": {
      "texture": [
       "fuzzy",
       "cells",
       "marble"
      ]
     }
    }
   ],
   "params": [
    {
     "name": "slot_d",
     "label": "Edge depth",
     "type": "number",
     "min": 6,
     "max": 25,
     "step": 1,
     "default": 20,
     "unit": "mm",
     "help": "From the lip to the back of the slot.",
     "simple": true
    },
    {
     "name": "grip_r",
     "label": "Lip radius",
     "type": "number",
     "min": 0.5,
     "max": 12,
     "step": 0.5,
     "default": 3,
     "unit": "mm",
     "help": "Roundover on the lip. Small is sharp, big is friendly. Slopers have no lip.",
     "simple": false
    },
    {
     "name": "edge_angle",
     "label": "Edge angle",
     "type": "number",
     "min": -45,
     "max": 20,
     "step": 1,
     "default": 0,
     "unit": "°",
     "help": "Positive: incut, the grip tilts in for traction (Tension uses 10°). Negative: sloper, one round curve (20° to 45°).",
     "simple": false
    },
    {
     "name": "slot_h",
     "label": "Slot height",
     "type": "number",
     "min": 16,
     "max": 30,
     "step": 1,
     "default": 22,
     "unit": "mm",
     "help": "Room for the fingers under the grip, where it is lowest. A steep or deep edge can leave less room, because the insert floor must stay.",
     "simple": false
    },
    {
     "name": "slot_w",
     "label": "Edge width",
     "type": "number",
     "min": 40,
     "max": 90,
     "step": 1,
     "default": 90,
     "unit": "mm",
     "help": "",
     "simple": false
    },
    {
     "name": "ergo",
     "label": "Ergo curve",
     "type": "number",
     "min": 0,
     "max": 5,
     "step": 0.5,
     "default": 0,
     "unit": "mm",
     "help": "The lip curves this far back in the middle for the longer middle fingers. The middle gets deeper, the ends shallower and rounder.",
     "simple": false
    },
    {
     "name": "texture",
     "label": "Pattern",
     "type": "choice",
     "options": [
      {
       "value": "none",
       "label": "Smooth",
       "group": "Like a real board",
       "about": "plain plastic, no texture."
      },
      {
       "value": "cells",
       "label": "Rock",
       "slicer": true,
       "noise": "voronoi",
       "group": "Like a real board",
       "about": "rough patches in a cell pattern, like sandstone. The favorite in the first test. Start here. Bambu Studio and Orca only."
      },
      {
       "value": "fuzzy",
       "label": "Resin",
       "slicer": true,
       "noise": "classic",
       "group": "Like a real board",
       "about": "a fine random grit, like a resin hangboard. Bambu Studio, Orca or PrusaSlicer make it. Start here if you use PrusaSlicer."
      },
      {
       "value": "dots",
       "label": "Dots",
       "modeled": true,
       "group": "Printed shapes",
       "about": "small cones, part of the edge. The best of the printed shapes in the first test."
      },
      {
       "value": "lines",
       "label": "Lines",
       "modeled": true,
       "group": "Printed shapes",
       "about": "ridges along the lip, across the pull, part of the edge."
      },
      {
       "value": "knurl",
       "label": "Knurl",
       "modeled": true,
       "group": "Printed shapes",
       "about": "small pyramids, part of the edge. The most bite, and the hardest on skin."
      },
      {
       "value": "marble",
       "label": "Marble",
       "slicer": true,
       "noise": "ridgedmulti",
       "group": "Printed shapes",
       "about": "rough veins that wander. Bambu Studio and Orca only."
      }
     ],
     "default": "none",
     "help": "Resin, Rock and Marble are made by your slicer: they add a 3MF for Bambu Studio and Orca to the download, and Resin a modifier file for PrusaSlicer. Dots, Lines and Knurl are part of the edge itself; pockets and steep slopers stay smooth. The feel described here is from one test print so far. Print the texture test to feel them all.",
